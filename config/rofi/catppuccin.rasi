/* Import warna dinamis dari Pywal */
@import "~/.cache/wal/colors-rofi-dark"

* {
    /* Mapping variabel Pywal ke nama yang kamu gunakan sebelumnya */
    bg:     @background;
    fg:     @foreground;
    accent: @color4;
    mauve:  @color6;
    accent: @selected-active-background;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font Propo 12";
}

window {
    background-color: @bg;
    border: 1px;             /* Menambahkan border agar aksen warna terlihat */
    border-color: @fg;   /* Border mengikuti warna wallpaper */
    border-radius: 12px;
    padding: 20px;
    width: 550px;
    height: 350px;
    /* Blur biasanya diatur di compositor (Hyprland), bukan di rasi */
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 5px;
}

inputbar {
    background-color: @bg; /* Sedikit transparan */
    border-radius: 8px;
    padding: 4px 2px;
}

prompt {
    enabled: true;
    padding: 0px 2px;
    text-color: @fg;
}

#textbox-prompt-colon {
    enabled: false;
}

element {
    background-color: transparent;
    padding: 5px;
}

element-text {
    text-color: @fg;
}

element-icon {
    size: 16px;
    padding: 0 10px 0 0;
}

element selected {
    /* Menggunakan warna aksen wallpaper dengan sedikit transparansi */
    background-color: @accent; 
    border-radius: 6px;
    padding: 2px 2px;
}

element selected element-text {
    text-color: @bg; /* Teks jadi gelap saat dipilih agar kontras */
    font-weight: bold;
}