/* ~/.config/rofi/list.rasi */

@import "~/.cache/wal/colors-rofi-dark"

* {
    background-color: transparent;
    text-color: @foreground;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 450px; /* Cukup sempit karena hanya berisi teks */
    background-color: @background;
    border-radius: 12px;
    padding: 15px;
    /* Memposisikan di tengah layar */
    location: center;
    anchor: center;
}

mainbox {
    orientation: vertical;
    children: [ inputbar, listview ];
    spacing: 15px;
}

inputbar {
    background-color: @color1;
    padding: 12px;
    border-radius: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @foreground;
    padding: 0 10px 0 0;
}

entry {
    placeholder: "Search...";
    text-color: @foreground;
}

listview {
    layout: vertical;
    columns: 1;
    lines: 8; /* Menampilkan 8 daftar Wi-Fi/Bluetooth sekaligus */
    spacing: 5px;
    scrollbar: false;
}

element {
    padding: 10px;
    border-radius: 8px;
}

element-text {
    vertical-align: 0.5;
    text-color: @foreground;
}

element selected {
    background-color: @color4;
}

element selected element-text {
    text-color: #ffffff;
    font-weight: bold;
}